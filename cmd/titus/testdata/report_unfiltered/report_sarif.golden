            {
              "id": "np.firebase.1",
              "name": "Firebase Cloud Messaging Server Key",
              "shortDescription": {
                "text": "Firebase Cloud Messaging (FCM) server key used for sending push notifications\nto Android, iOS, and web applications. An attacker with this key can send\nunauthorized push notifications to all devices registered with the Firebase\nproject, potentially enabling phishing attacks, spam campaigns, or social\nengineering. The key grants full authority over FCM messaging for the project.\n"
              },
              "helpUri": "https://firebase.google.com/docs/cloud-messaging/server"
            },
            {
              "id": "np.firebase.2",
              "name": "Firebase Cloud Messaging Device Token",
              "shortDescription": {
                "text": "Firebase Cloud Messaging (FCM) registration token (device token) used to identify\na specific app instance on a device for receiving push notifications. While not\na server credential, leaked device tokens can be exploited to send unauthorized\npush notifications to specific users, enabling targeted phishing or spam attacks.\nThe 22-character prefix is the Firebase Instance ID.\n"
              },
              "helpUri": "https://firebase.google.com/docs/cloud-messaging/manage-tokens"
            },
            {
              "id": "np.firecrawl.1",
              "name": "Firecrawl API Key",
              "shortDescription": {
                "text": "A Firecrawl API Key was found. Firecrawl provides LLM-centric services for web scraping and crawling. An attacker could use this API key to consume limited, possibly paid resources, or cause denial-of-service.\n"
              },
              "helpUri": "https://www.firecrawl.dev"
            },
            {
              "id": "np.gcs.1",
