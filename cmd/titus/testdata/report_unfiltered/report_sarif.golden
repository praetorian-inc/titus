            },
            {
              "id": "np.instagram.1",
              "name": "Instagram Graph API Access Token",
              "shortDescription": {
                "text": "Instagram Graph API Access Token starting with IGQVJ prefix.\nAn attacker with this credential can access user profile data,\nread media posts and comments, and potentially manage\nInstagram business accounts connected to the token.\n"
              },
              "helpUri": "https://developers.facebook.com/docs/instagram-basic-display-api/"
            },
            {
              "id": "np.iterable.1",
              "name": "Iterable API Key",
              "shortDescription": {
                "text": "Iterable API Key used for marketing automation platform access.\nAn attacker with this credential can send emails and push notifications,\naccess user profile data, manage campaigns and workflows, export\nsubscriber lists, and modify audience segments via the Iterable API.\n"
              },
              "helpUri": "https://api.iterable.com/api/docs"
            },
            {
              "id": "np.jamf.1",
              "name": "JAMF Pro Credential",
              "shortDescription": {
                "text": "JAMF Pro credential used for mobile device management (MDM) API access.\nJAMF Pro is an enterprise endpoint management platform for Apple devices.\nAn attacker with this credential can access the JAMF Pro API to enumerate\nmanaged devices, deploy configuration profiles, execute remote commands\n(lock, wipe, restart), install software, and exfiltrate device inventory\ndata across all managed endpoints.\n"
              },
              "helpUri": "https://developer.jamf.com/jamf-pro/docs/jamf-pro-api-overview"
            },
            {
              "id": "np.jenkins.1",
