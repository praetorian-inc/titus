            },
            {
              "id": "np.hashicorp.7",
              "name": "Hashicorp Vault Unseal Key",
              "shortDescription": {
                "text": "A Hashicorp Vault unseal key was found. This may allow an attacker the ability to decrypt a vault.\n"
              },
              "helpUri": "https://developer.hashicorp.com/vault/docs/concepts/seal"
            },
            {
              "id": "np.helpscout.1",
              "name": "Help Scout OAuth Client Secret",
              "shortDescription": {
                "text": "Help Scout OAuth Client Secret used with client_credentials flow.\nAn attacker with this credential and the client ID can obtain\nOAuth access tokens to read and modify mailboxes, conversations,\ncustomer profiles, and team data via the Help Scout Mailbox API.\n"
              },
              "helpUri": "https://developer.helpscout.com/mailbox-api/"
            },
            {
              "id": "np.heroku.1",
              "name": "Heroku API Key",
              "shortDescription": {
                "text": ""
              },
              "helpUri": "https://devcenter.heroku.com/articles/authentication"
            },
            {
              "id": "np.html.1",
              "name": "HTML Password Input Pre-populated Credential",
              "shortDescription": {
                "text": "A credential value was detected in the HTML value attribute of an \u003cinput type=\"password\"\u003e element. Web applications that pre-populate password fields expose credentials in HTTP response bodies and HTML source. Although the browser visually masks the field, the credential is plaintext in the page source and retrievable via browser developer tools, web proxy, or source-view. This pattern commonly indicates service account passwords stored in admin configuration panels.\n"
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/312.html"
            },
            {
              "id": "np.http.1",
              "name": "HTTP Basic Authentication",
              "shortDescription": {
