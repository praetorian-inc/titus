              "id": "kingfisher.dbconn.csharp.1",
              "name": "C# Database Connection Object with Password",
              "shortDescription": {
                "text": "A C# database connection object constructed with an inline connection\nstring containing a password was found.\n"
              },
              "helpUri": "https://learn.microsoft.com/en-us/dotnet/api/system.data.sqlclient.sqlconnection"
            },
            {
              "id": "kingfisher.dbconn.perl.1",
              "name": "Perl DBI Connection with Credentials",
              "shortDescription": {
                "text": "A Perl DBI database connection with hardcoded credentials was found.\nDBI-\u003econnect() takes a DSN, username, and password as arguments.\n"
              },
              "helpUri": "https://metacpan.org/pod/DBI"
            },
            {
              "id": "kingfisher.dbconn.php.1",
              "name": "PHP Database Connection with Credentials",
              "shortDescription": {
                "text": "A PHP MySQL database connection function call with hardcoded string\narguments was found. These typically contain host, username,\nand password parameters as literal strings.\n"
              },
              "helpUri": "https://www.php.net/manual/en/function.mysqli-connect.php"
            },
            {
              "id": "kingfisher.dbconn.php.2",
