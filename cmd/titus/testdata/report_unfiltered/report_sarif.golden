            },
            {
              "id": "np.square.1",
              "name": "Square Access Token",
              "shortDescription": {
                "text": "Square Access Token (legacy format) used for payment processing APIs.\nAn attacker with this credential can process payments, access transaction\nhistory, manage inventory, and retrieve customer information via the\nSquare Connect API. Tokens with full access can modify account settings\nand financial data. Legacy tokens use the sq0atp- prefix; newer tokens\nuse a different format (EAAA prefix).\n"
              },
              "helpUri": "https://developer.squareup.com/docs/build-basics/access-tokens"
            },
            {
              "id": "np.square.2",
              "name": "Square OAuth Secret",
              "shortDescription": {
                "text": "Square OAuth Application Secret used for OAuth2 token exchange.\nAn attacker with this credential, combined with the application ID,\ncan obtain OAuth access tokens on behalf of merchants, potentially\ngaining access to payment processing, customer data, and financial\nrecords. The secret is used in the OAuth2 authorization flow to\nexchange authorization codes for access tokens.\n"
              },
              "helpUri": "https://developer.squareup.com/docs/oauth-api/overview"
            },
