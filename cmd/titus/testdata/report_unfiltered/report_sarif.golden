            {
              "id": "np.jenkins.2",
              "name": "Jenkins Setup Admin Password",
              "shortDescription": {
                "text": "A Jenkins setup wizard admin user password was detected.\nThis password is used to configure a new Jenkins installation.\nAn attacker with possession of this password could control the Jenkins instance.\nThis could enable exfiltration of proprietary code, insertion of backdoors, or lateral movement to other resources.\n"
              },
              "helpUri": "https://www.jenkins.io/doc/book/installing/linux/#setup-wizard"
            },
