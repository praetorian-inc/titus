              "id": "np.azure.1",
              "name": "Azure Connection String",
              "shortDescription": {
                "text": "Credentials in an Azure connection string were found. Depending on assigned privileges, these may allow an attacker read or write access to Azure storage.\n"
              },
              "helpUri": "https://azure.microsoft.com/en-us/blog/windows-azure-web-sites-how-application-strings-and-connection-strings-work/"
            },
            {
