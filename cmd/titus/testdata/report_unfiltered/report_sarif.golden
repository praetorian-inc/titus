            {
              "id": "kingfisher.cisco.1",
              "name": "Cisco Enable Password",
              "shortDescription": {
                "text": "A Cisco IOS enable password or enable secret was found in a\nnetwork device configuration. Enable passwords grant privileged\nEXEC mode access to the device.\n"
              },
              "helpUri": "https://www.cisco.com/c/en/us/td/docs/ios/security/command/reference/sec_book/sec_e1.html"
            },
            {
              "id": "kingfisher.cisco.2",
              "name": "SNMP Read-Write Community String",
              "shortDescription": {
                "text": "An SNMP read-write community string was found in a network device\nconfiguration. RW community strings allow full management access\nto the device via SNMP, including configuration changes.\n"
              },
              "helpUri": "https://www.cisco.com/c/en/us/td/docs/ios-xml/ios/snmp/configuration/xe-16/snmp-xe-16-book.html"
            },
            {
              "id": "kingfisher.cisco.3",
              "name": "Cisco PAC Key",
              "shortDescription": {
                "text": "A Cisco Protected Access Credential (PAC) key was found.\nPAC keys are used in 802.1x EAP-FAST authentication and\ncan be used to impersonate the RADIUS server.\n"
              }
            },
            {
              "id": "kingfisher.cisco.4",
              "name": "Network Config NVRAM Indicator",
              "shortDescription": {
                "text": "A network device NVRAM configuration dump indicator was found.\nThis line appears at the top of Cisco IOS running-config exports,\nindicating the file likely contains device credentials and\nconfiguration details.\n"
              }
            },
