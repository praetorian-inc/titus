            {
              "id": "np.generic.8",
              "name": "Credentials in .NET System.DirectoryServices.DirectoryEntry",
              "shortDescription": {
                "text": "A .NET `System.DirectoryServices.DirectoryEntry` value was found with hardcoded credentials. This may allow an attacker access to an Active Directory instance.\n"
